# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# PostgreSQL Database (choose one method)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# OR individual variables:
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=password

# LLM Provider (choose one)
GEMINI_API_KEY=your-gemini-api-key
# OR
OPENAI_API_KEY=your-openai-api-key

# Hindsight (optional) - long-term memory via https://hindsight.vectorize.io
# Cloud API URL: https://api.hindsight.vectorize.io  (promo code MEMHACK89 for $50 credits)
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BANK_ID=incident-memory
# Optional bank missions (the bank is auto-created with these):
# HINDSIGHT_REFLECT_MISSION=You are the long-term memory of an on-call incident response team.
# HINDSIGHT_RETAIN_MISSION=Extract each incident's key details, root cause, resolution and lesson.
